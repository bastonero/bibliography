@Article{Lazzeri2003,
  author     = {Lazzeri, Michele and Mauri, Francesco},
  journal    = {Physical Review Letters},
  title      = {First-principles calculation of vibrational {Raman} spectra in large systems: {Signature} of small rings in crystalline {SiO}$_2$},

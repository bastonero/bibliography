@Article{Menon2021,
  author    = {Menon, Sarath and Lysogorskiy, Yury and Rogal, Jutta and Drautz, Ralf},
  journal   = {Physical Review Materials},
  title     = {Automated free-energy calculation from atomistic simulations},

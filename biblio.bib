@Article{Silvestrelli1998,
  author     = {Silvestrelli, Pier Luigi and Marzari, Nicola and Vanderbilt, David and Parrinello, Michele},
  journal    = {Solid State Communications},
  title      = {Maximally-localized {Wannier} functions for disordered systems: {Application} to amorphous silicon},
  year       = {1998},
  issn       = {0038-1098},
  month      = may,
  number     = {1},
  pages      = {7--11},
  volume     = {107},
  abstract   = {We use the maximally-localized Wannier function method to study bonding properties in amorphous silicon. This study represents, to our knowledge, the first application of the Wannier-function analysis to a disordered system. Our results show that, in the presence of disorder, this method is extremely helpful in providing an unambiguous picture of the bond distribution. In particular, defect configurations can be studied and characterized with a novel degree of accuracy that was not available before.},

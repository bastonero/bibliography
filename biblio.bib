@Article{Vanderbilt1984,
  author    = {Vanderbilt, David and Louie, Steven G.},
  journal   = {Physical Review B},
  title     = {Total energies of diamond (111) surface reconstructions by a linear combination of atomic orbitals method},
  year      = {1984},

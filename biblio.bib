@Article{Esteras2022,
  author    = {Esteras, Dorye L. and Rybakov, Andrey and Ruiz, Alberto M. and Baldoví, José J.},
  journal   = {Nano Letters},
  title     = {Magnon {Straintronics} in the {2D} van der {Waals} {Ferromagnet} {CrSBr} from {First}-{Principles}},
  year      = {2022},
  issn      = {1530-6984},
  month     = nov,
  number    = {21},
  pages     = {8771--8778},
  volume    = {22},
  abstract  = {The recent isolation of two-dimensional (2D) magnets offers tantalizing opportunities for spintronics and magnonics at the limit of miniaturization. One of the key advantages of atomically thin materials is their outstanding deformation capacity, which provides an exciting avenue to control their properties by strain engineering. Herein, we investigate the magnetic properties, magnon dispersion, and spin dynamics of the air-stable 2D magnetic semiconductor CrSBr (TC = 146 K) under mechanical strain using first-principles calculations. Our results provide a deep microscopic analysis of the competing interactions that stabilize the long-range ferromagnetic order in the monolayer. We showcase that the magnon dynamics of CrSBr can be modified selectively along the two main crystallographic directions as a function of applied strain, probing the potential of this quasi-1D electronic system for magnon straintronics applications. Moreover, we predict a strain-driven enhancement of TC by ∼30\%, allowing the propagation of spin waves at higher temperatures.},
  doi       = {10.1021/acs.nanolett.2c02863},
  groups    = {Hubbard},
  publisher = {American Chemical Society},
  url       = {https://doi.org/10.1021/acs.nanolett.2c02863},
  urldate   = {2024-09-20},
}

